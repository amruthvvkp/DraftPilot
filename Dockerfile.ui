# Build the browser application before packaging the Python runtime.
FROM node:22-alpine AS frontend-build

WORKDIR /frontend
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim

EXPOSE 8000

# Install uv.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Keeps Python from generating .pyc files in the container
ENV PYTHONDONTWRITEBYTECODE=1

ENV UV_LINK_MODE=copy

# Turns off buffering for easier container logging
ENV PYTHONUNBUFFERED=1


WORKDIR /app
COPY . /app
COPY --from=frontend-build /frontend/dist /app/frontend/dist

# Set INSTALL_DEBUGPY=true (compose.dev.yml does this) to add the debugpy group.
ARG INSTALL_DEBUGPY=false

RUN --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-cache --group ui \
    $( [ "${INSTALL_DEBUGPY}" = "true" ] && printf '%s' "--group debugpy" )
