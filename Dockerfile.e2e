# Keep browser tests reproducible locally and in CI using Playwright's pinned image.
FROM mcr.microsoft.com/playwright/python:v1.62.0-noble

WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY README.md ./
COPY src ./src
COPY tests ./tests

RUN pip install --no-cache-dir uv \
    && UV_PROJECT_ENVIRONMENT=/opt/venv uv sync --frozen --group web --group e2e

ENV PATH="/opt/venv/bin:${PATH}"
CMD ["pytest", "-q", "tests/e2e", "--browser", "chromium", "--base-url", "http://ui:8000"]
