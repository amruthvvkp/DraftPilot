# Container definition for the local retrieval service.

FROM python:3.13-slim

EXPOSE 8000

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/
ENV PYTHONDONTWRITEBYTECODE=1 UV_LINK_MODE=copy PYTHONUNBUFFERED=1

WORKDIR /app
COPY . /app

RUN --mount=type=cache,target=/root/.cache/uv uv sync --frozen --no-cache --group ui

CMD ["uv", "run", "uvicorn", "draftpilot.rag_service:app", "--host", "0.0.0.0", "--port", "8000"]
