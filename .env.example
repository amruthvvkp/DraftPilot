# Copy to .env and adjust. docker compose reads .env automatically.

# --- Telemetry ----------------------------------------------------------------
# OFF by default. To see traces, logs and metrics locally, start the bundled Grafana LGTM
# (`docker compose --profile observability up`, Grafana on :3300) and enable export:
# OTEL__ENABLED=true
# OTLP/HTTP endpoint. Defaults to the bundled otel-lgtm; point it at any OTLP collector.
# OTEL__EXPORTER_OTLP_ENDPOINT=http://otel-lgtm:4318

# --- Durable execution (Temporal) ---------------------------------------------
# compose runs a Temporal dev server (UI on :8233). Outside Docker use localhost:7233.
# TEMPORAL__HOST=temporal:7233
# TEMPORAL__NAMESPACE=default
# TEMPORAL__TASK_QUEUE=draftpilot

# --- Published host ports -----------------------------------------------------
# Container-internal ports are fixed; these only change what's exposed on the host.
# Postgres/Redis default OFF the standard ports so they don't clash with a local
# Postgres (5432) / Redis (6379) or your shared stack. Override as needed.
# DRAFTPILOT_POSTGRES_PORT=55432
# DRAFTPILOT_REDIS_PORT=56379
# DRAFTPILOT_UI_PORT=9000
# DRAFTPILOT_MCP_PORT=9001
# DRAFTPILOT_RAG_PORT=9010
# DRAFTPILOT_TEMPORAL_PORT=7233
# DRAFTPILOT_TEMPORAL_UI_PORT=8233
# DRAFTPILOT_GRAFANA_PORT=3300
# DRAFTPILOT_OTLP_HTTP_PORT=4318
# RAG__DATABASE_PATH=/data/draftpilot-rag.sqlite3  # Compose volume path
# RAG__SERVICE_URL=http://rag:8000
# RAG__EMBEDDING_PROVIDER=hash  # hash or lexical
# BACKUP__ROOT=/data/backups
# MONTY__ENABLED=false
# MONTY__MAX_CODE_CHARS=20000
# MONTY__MAX_INPUT_ITEMS=100
# MONTY__MAX_DURATION_SECONDS=0.5
# MONTY__MAX_OUTPUT_CHARS=20000
# MCP__REQUEST_TIMEOUT_SECONDS=10
# MCP__MAX_OUTPUT_CHARS=100000
# MCP__STDIO_CLIENT_ID=mcp-stdio  # registered identity for local stdio grants
# MCP__ADMIN_TOKEN=replace-with-a-separate-admin-token
# MCP__CLIENT_TOKENS={"claude":"replace-with-client-token"}

# --- LLM provider ------------------------------------------------------------
# Default: local LM Studio. `auto` uses the first model LM Studio reports as loaded.
# Providers: lm_studio, ollama, openai, openrouter, gateway (OpenAI-compatible), anthropic, google.
# More profiles (with encrypted keys) can be added in Settings → Providers.
# LLM__ENABLED=true
# LLM__PROVIDER=lm_studio
# LLM__MODEL=auto
# LLM__BASE_URL=http://host.docker.internal:1234/v1   # compose default; use localhost outside Docker
# LLM__API_KEY=
# LLM__THINKING=auto   # auto (per role) · on · off (faster on local reasoning models)
# Private hosts allowed as model servers (everything else private stays blocked, anti-SSRF):
# LLM__TRUSTED_MODEL_HOSTS=["host.docker.internal"]

# --- Debug ports (compose.dev.yml) --------------------------------------------
# DRAFTPILOT_UI_DEBUGPY_PORT=5678
# DRAFTPILOT_WORKER_DEBUGPY_PORT=5679

# --- Studio access (REST API) -------------------------------------------------
# When set, the web API requires this token: the browser asks for it once and keeps an
# HttpOnly session cookie; scripts send `Authorization: Bearer <token>`. Leave empty only
# for a loopback-only machine. Rotating it signs every browser out.
# API__TOKEN=                          # CHANGEME: openssl rand -hex 32
# API__COOKIE_SECURE=true              # set when served over HTTPS

# --- Local LM Studio for Tier 1 tests and evals ---------------------------------
# EVAL__BASE_URL=http://localhost:1234/v1
# EVAL__CHAT_MODEL=                    # empty = first loaded model
# EVAL__JUDGE_MODEL=
# EVAL__EMBEDDING_MODEL=
